<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!--
        Saved-data migrations, one file per change to the saved data, listed here oldest first.
        Each runs once, at start-up (Startup.lua), and is remembered by its flag. Add new files at
        the end, and never rename, reorder or reuse one. 000_SavedNames is the one exception. It
        renamed the saved tables and fields, and the older files were changed to read the new
        names, so it runs before them.

        Name files by order and change, like 001_SomethingRenamed.lua. Start each with a comment
        saying what changed and what the migration does about it, then register it like this:

            local env = select(2, ...)
            local Private = env.AX_Modules:Import("@\\Menu\\Data\\Private")

            Private.RegisterMigration({
                flag = "SomethingRenamed",
                db   = Private.MigrationDB.Account,
                run  = function(stored) end,
            })

        flag  remembered in that saved variables table once the migration has run
        db    Private.MigrationDB.Account, or Character to run once on every character
        run   gets that saved variables table
    -->
    <Script file="000_SavedNames.lua"/>
    <Script file="001_CenterQuickSlot.lua"/>
    <Script file="002_LastUsedByKey.lua"/>
    <Script file="003_ActionBarMenus.lua"/>
</Ui>
