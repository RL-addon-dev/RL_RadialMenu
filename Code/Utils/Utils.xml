<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!--
        The addon's own utilities, one module per topic (Utils_Spell is "@\\Utils\\Spell"). They
        wrap WoW APIs and aren't about menus, so any part of the addon can use them, and one day
        they could move into the AX libraries. They load before the settings and the menus.
    -->
    <Script file="Utils_API.lua"/>
    <Script file="Utils_Spell.lua"/>
    <Script file="Utils_Spec.lua"/>
    <Script file="Utils_Pet.lua"/>
    <Script file="Utils_Item.lua"/>
    <Script file="Utils_Unit.lua"/>
    <Script file="Utils_Housing.lua"/>
    <Script file="Utils_Text.lua"/>
    <Script file="Utils_ConsolePort.lua"/>
    <Script file="Utils_EditMode.lua"/>
</Ui>
